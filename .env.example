# ---------------------------------------------------------------------------
# Dolfin — environment configuration
#
# Copy to `.env.local` for local development.
#
# Every PHINITE_* value is server-only and must never be prefixed with
# NEXT_PUBLIC_, otherwise it is inlined into the browser bundle.
#
# Dolfin ships no business data of its own. Without these values the app runs,
# but every screen shows an explicit "connect your Store Manager" state.
# ---------------------------------------------------------------------------

# --- Authentication --------------------------------------------------------
# Workspace API key from Phinite. Sent as `Authorization: Bearer <key>`.
PHINITE_API_KEY=

# --- Endpoint --------------------------------------------------------------
# Option A (recommended): let Dolfin construct the documented trigger URLs
#   POST {base}/api/v1/ai/trigger/{workspace}/{trigger}/{environment}
PHINITE_BASE_URL=https://app.phinite.ai
PHINITE_WORKSPACE_ID=
PHINITE_TRIGGER_ID=
PHINITE_ENVIRONMENT=PROD

# Option B: paste a full endpoint URL. Also how a "Deploy as Chat API"
# endpoint is wired up. Takes precedence over Option A.
PHINITE_AGENT_URL=

# --- Execution mode --------------------------------------------------------
# background — start the run, then poll for status. Recommended by Phinite for
#              multi-step graphs, and the default here.
# sync       — one blocking call. Phinite caps these at roughly 120–150s.
PHINITE_EXECUTION_MODE=background

PHINITE_TIMEOUT_MS=150000
PHINITE_POLL_INTERVAL_MS=3000
PHINITE_MAX_WAIT_MS=180000

# Replay a successful graph response instead of waiting 15–65s again.
# Default 30 minutes. Set 0 to disable. Append ?refresh=1 to any GET to bypass.
PHINITE_CACHE_TTL_MS=1800000

# Override only if your status endpoint differs from the default
# {base}/api/v1/ai/trigger/status/{workspace_id}/{workflow_id}
PHINITE_STATUS_URL=

# --- Optional: split the graph across triggers ------------------------------
# Prefer one Store Manager graph that orchestrates the specialists. These are
# only needed if your deployment exposes each agent separately. Anything left
# blank falls back to the store manager trigger above.
PHINITE_DASHBOARD_TRIGGER_ID=
PHINITE_INVENTORY_TRIGGER_ID=
PHINITE_VENDOR_TRIGGER_ID=
PHINITE_PROCUREMENT_TRIGGER_ID=

# Full-URL equivalents, if you have those instead of trigger ids.
PHINITE_DASHBOARD_URL=
PHINITE_INVENTORY_URL=
PHINITE_VENDOR_URL=
PHINITE_PROCUREMENT_URL=

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Dolfin

# The store being managed. Identity configuration, not business data — replaced
# by a real session once an auth platform exists.
MERCHANT_ID=M001
